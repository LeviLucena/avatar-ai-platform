# Copy to .env and edit. Without any key the platform runs in "heuristic" mode
# (rule-based fallbacks) so you can still click through everything.

# --- NVIDIA Nemotron (hosted NIM API, OpenAI-compatible): get a key at build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b

# --- Anthropic (optional alternative provider)
ANTHROPIC_API_KEY=
# auto = nvidia if NVIDIA_API_KEY is set, else anthropic | nvidia | anthropic
LLM_PROVIDER=auto
# auto | demo (demo forces the heuristic fallbacks even if a key exists)
LLM_MODE=auto

JWT_SECRET=change-me-to-a-long-random-string
INGEST_KEY=dev-ingest-key

# SQLite by default; any SQLAlchemy URL works (e.g. PostgreSQL)
DATABASE_URL=sqlite:///./avatar.db
SEED_DEMO=true
